rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Her "ev" kendi kodunun altında yaşar. Kodu bilen (davet linkini alan) herkes o evi okur/yazar.
    // Anonim giriş zorunlu; başka her şey kapalı.
    match /homes/{home}/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
